# Copy this file to .env.local and set your Apple Developer Team ID
# Find your Team ID at https://developer.apple.com/account (Membership Details)
HOMEKIT_TEAM_ID=YOUR_TEAM_ID

# App Store Connect API (optional, for --testflight automation)
# Create an API key at https://appstoreconnect.apple.com/access/integrations/api
# ASC_ISSUER_ID=your-issuer-uuid
# ASC_KEY_ID=your-key-id

# Xcode toolchain (optional). The project pins its Xcode in .xcode-version and
# resolves it by version, so this is only needed to build with a different one.
# XCODE_APP=/Applications/Xcode.app

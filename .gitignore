.DS_Store
/.build
/build
# Includes: .build/app/ (assembled .app bundle), .build/DerivedData/ (xcodebuild)
/Packages
xcuserdata/
DerivedData/
.swiftpm/
.netrc

# Generated Xcode projects (regenerate with: xcodegen generate)
*.xcodeproj
*.xcworkspace

# Local configuration (contains developer Team ID)
.env.local

# Auto-incrementing build number (local per machine)
.build-number

# Generated device maps (user-specific snapshots)
device-map*.json
device-map*.md

# Node.js
node_modules/

# Astro site (not in npm workspaces — has its own lock file)
site/dist/
site/.astro/
site/package-lock.json

# AI coding tool directories
.adal/
.agent/
.augment/
.codebuddy/
.commandcode/
.continue/
.cortex/
.crush/
.factory/
.goose/
.iflow/
.junie/
.kilocode/
.kiro/
.kode/
.mcpjam/
.mux/
.neovate/
.openhands/
.pi/
.pochi/
.qoder/
.qwen/
.roo/
.trae/
.vibe/
.windsurf/
.zencoder/
.playwright-cli/
openclaw/package-lock.json
openclaw/dist/

# Python bytecode cache
__pycache__/
*.pyc
openclaw/reports/

# Fastlane runtime artifacts (lanes write reports + screenshots/metadata caches)
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output
fastlane/README.md.bak

# macOS Spotlight indexing markers
.metadata_never_index

# Claude Code session state
.claude/scheduled_tasks.lock

# Local dev MCP config — must stay untracked. The Claude Code plugin's root is
# the repo root (marketplace.json source: "./"), so a tracked .mcp.json would
# ship with the plugin and register its servers for every user (issue #84).
.mcp.json

# Clawpatch local review state
.clawpatch/

.worktrees/
.superpowers

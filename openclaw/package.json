{
  "name": "homeclaw",
  "version": "1.0.4",
  "private": true,
  "description": "OpenClaw plugin for HomeKit smart home control — lights, locks, thermostats, and scenes",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "src/",
    "skills/",
    "agents/",
    "hooks/",
    "openclaw.plugin.json"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "homekit",
    "smart-home",
    "lights",
    "thermostats",
    "scenes"
  ],
  "author": {
    "name": "Omar Shahine",
    "email": "omar@omarknows.app"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/omarshahine/HomeClaw.git",
    "directory": "openclaw"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48",
    "openclaw": "^2026.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.23"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "plugin:check": "npm run build && npx --yes @openclaw/plugin-inspector inspect --no-openclaw",
    "plugin:ci": "npm run build && npx --yes @openclaw/plugin-inspector ci --no-openclaw --runtime --mock-sdk --allow-execute",
    "prepack": "npm run build"
  }
}
